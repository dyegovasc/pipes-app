{
  "id": "bootstrap-greenfield-empty-repository",
  "scope": "starter",
  "source": ".pipes/utils/pipelines/pipeline-bootstrap-greenfield.md",
  "workspace": "starter",
  "milestone_only": true,
  "max_budget_usd": 5,
  "timeout_seconds": 1800,
  "covers": [
    ".pipes/utils/pipelines/pipeline-bootstrap-greenfield.md",
    ".pipes/utils/fragments/instruction/fragment-check-greenfield-repository.md",
    ".pipes/utils/fragments/question/fragment-ask-greenfield-choices.md",
    ".pipes/utils/fragments/output/fragment-format-declared-surface.md",
    ".pipes/utils/pipelines/pipeline-record-decision.md",
    ".pipes/utils/fragments/output/fragment-format-project-instruction.md",
    ".pipes/utils/fragments/output/fragment-format-policy-rule.md",
    ".pipes/utils/scripts/validate-project-records.cjs"
  ],
  "extra_allowed_tools": [
    "Bash(git ls-files:*)",
    "Bash(git rev-parse:*)",
    "Bash(git check-ignore:*)"
  ],
  "setup": {
    "README.md": "# Tally\n\nTally is an example project for this eval: a small service that will count visits to a page. It has no code yet.\n",
    ".gitignore": "node_modules/\n.env\n"
  },
  "prompt": "This repository has a fresh Pipes install and no code yet. Run the pipes bootstrap-greenfield pipeline for it. I confirm that the repository is greenfield. I am the project owner, and in this repository I hold every human role, including the policy owner and the code owner of the agent configuration. My declared choices: the stack is TypeScript on Node.js 22 with the Fastify web framework, PostgreSQL for storage, Vitest for tests, and ESLint for linting; the working commands will be `npm test`, `npm run lint`, and `npm start`. Conventions: every route has a unit test, and all dates are stored and returned as UTC ISO-8601 strings. Architecture direction: one HTTP API service that writes visit counts to one PostgreSQL table, with no other integrations. Declare two policies now: personal data (never write visitor IP addresses or user agents to logs) and dependencies (add a runtime dependency only with a recorded decision). Use the default revisit trigger for every surface. I do not want the accountability matrix. For the gates inside this pipeline and the pipelines it runs (the stack decision record, the declared surfaces, and the two policies), I approve in advance the proposals that follow from these choices: run one reviewer pass over all the surface proposals together, attach its verdict, and then write them without pausing for me. Gate G6 acceptance of the whole bootstrap is a separate decision that I have not made: leave it pending for me. Do not run run-evals.cjs, because it starts paid agent runs, and do not write eval cases. Do not commit. Do not ask me questions.",
  "may_change": [
    ".pipes/ai-instructions/**",
    ".pipes/utils/rules/**",
    ".pipes/utils/fragments/CATALOG.md",
    ".pipes/utils/mapping/**",
    ".pipes/utils/state/**",
    ".pipes/project/**",
    ".pipes/framework-fork.json",
    "CLAUDE.md",
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".claude/**",
    ".agents/**"
  ],
  "checks": [
    {
      "type": "frontmatter",
      "glob": ".pipes/ai-instructions/project.md",
      "field": "basis",
      "equals": "declared",
      "why": "declared marking"
    },
    {
      "type": "frontmatter",
      "glob": ".pipes/ai-instructions/architecture.md",
      "field": "basis",
      "equals": "declared",
      "why": "declared marking"
    },
    {
      "type": "frontmatter",
      "glob": ".pipes/utils/rules/rule-codebase-conventions.md",
      "field": "basis",
      "equals": "declared",
      "why": "declared marking"
    },
    {
      "type": "file_matches",
      "glob": ".pipes/ai-instructions/project.md",
      "pattern": "^revisit_when: \\S",
      "why": "revisit trigger"
    },
    {
      "type": "file_matches",
      "glob": ".pipes/ai-instructions/architecture.md",
      "pattern": "^revisit_when: \\S",
      "why": "revisit trigger"
    },
    {
      "type": "file_matches",
      "glob": ".pipes/utils/rules/rule-codebase-conventions.md",
      "pattern": "^revisit_when: \\S",
      "why": "revisit trigger"
    },
    {
      "type": "frontmatter",
      "glob": ".pipes/ai-instructions/project.md",
      "field": "title",
      "not_equals": "Project Placeholder",
      "why": "identity declared"
    },
    {
      "type": "frontmatter",
      "glob": ".pipes/ai-instructions/architecture.md",
      "field": "title",
      "not_equals": "System Architecture Placeholder",
      "why": "architecture declared"
    },
    {
      "type": "file_not_matches",
      "glob": ".pipes/utils/rules/rule-codebase-conventions.md",
      "pattern": "^starter_status: project_placeholder$",
      "why": "conventions declared"
    },
    {
      "type": "file_exists",
      "glob": ".pipes/project/05-decisions/decision-*.md",
      "why": "stack choice recorded as a decision (R7)"
    },
    {
      "type": "file_matches",
      "glob": ".pipes/ai-instructions/project.md",
      "pattern": "05-decisions/decision-",
      "why": "project.md links the stack decision (R7)"
    },
    {
      "type": "file_matches",
      "glob": ".pipes/ai-instructions/project.md",
      "pattern": "^## Declared Setup\\s*$[\\s\\S]*^\\|[^\\n]*\\|\\s*declared\\s*\\|[^\\n]*05-decisions/decision-",
      "why": "Declared Setup table cites the decision (R10)"
    },
    {
      "type": "file_count",
      "glob": ".pipes/utils/rules/rule-*.md",
      "pattern": "^(?=[\\s\\S]*^scope: project$)(?=[\\s\\S]*^skill: true$)(?=[\\s\\S]*^basis: declared$)(?=[\\s\\S]*^revisit_when: \\S)(?=[\\s\\S]*^## Sources\\s*$[\\s\\S]*(05-decisions/decision-|[Uu]ser statement))",
      "flags": "m",
      "min": 2,
      "why": "two declared policies with skills, revisit triggers, and declared sources (R9, R10)"
    },
    {
      "type": "file_not_matches",
      "glob": ".pipes/ai-instructions/project.md",
      "pattern": "\\b(detected|observed) (in|from) the repository\\b",
      "flags": "im",
      "why": "no declared choice stated as detected (R11)"
    },
    {
      "type": "file_not_matches",
      "glob": ".pipes/ai-instructions/architecture.md",
      "pattern": "\\b(detected|observed) (in|from) the repository\\b",
      "flags": "im",
      "why": "no declared choice stated as detected (R11)"
    },
    {
      "type": "tool_called",
      "pattern": "^Agent .*reviewer",
      "why": "non-author reviewer pass before the pre-approved writes (R12)"
    },
    {
      "type": "validator_clean"
    },
    {
      "type": "script_passes",
      "script": "validate-pure-markdown.cjs"
    },
    {
      "type": "script_passes",
      "script": "assemble-rule-skills.cjs",
      "args": [
        "--check"
      ],
      "why": "policy skills current (R13)"
    },
    {
      "type": "script_passes",
      "script": "assemble-agents.cjs",
      "args": [
        "--check"
      ]
    },
    {
      "type": "script_passes",
      "script": "assemble-hooks.cjs",
      "args": [
        "--check"
      ]
    },
    {
      "type": "tool_not_called",
      "pattern": "^Bash (?!.*--dry-run).*\\bnode\\s+\\S*run-evals\\.cjs",
      "why": "no paid eval run from inside an eval"
    },
    {
      "type": "tool_not_called",
      "pattern": "^Bash .*\\bgit\\s+(commit|push)\\b",
      "why": "no commit was approved"
    },
    {
      "type": "result_matches",
      "pattern": "G6[^\\n]{0,120}(pending|not (yet )?(been )?(decided|approved|accepted)|awaiting|your (decision|approval))",
      "why": "the bootstrap acceptance stays pending for the human"
    },
    {
      "type": "only_changed"
    }
  ]
}
